---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>邵明鉴 — 飞书 & AI 效率赋能</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    
    <!-- Google Fonts: Sora (display) + Inter (body) + Noto Sans SC (Chinese) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Noto+Sans+SC:wght@400;500;700&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet">
    
    <script defer src="https://analytics.mjshao.fun/script.js" data-website-id="93f7d802-084f-45f6-91bf-72a7b1ee6262"></script>
    <style>
      /* ===== RESET & BASE ===== */
      *, *::before, *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --bg-dark: #0a0a0f;
        --bg-gradient: linear-gradient(180deg, #0a0a0f 0%, #0f0f1a 100%);
        --accent: #00d4ff;
        --accent-glow: rgba(0, 212, 255, 0.3);
        --accent-warm: #22d3ee;
        --feishu-blue: #3370ff;
        --text-primary: #ffffff;
        --text-secondary: #94a3b8;
        --text-muted: #64748b;
        --card-bg: rgba(255, 255, 255, 0.03);
        --card-border: rgba(255, 255, 255, 0.08);
        --font-display: 'Sora', 'Noto Sans SC', sans-serif;
        --font-body: 'Inter', 'Noto Sans SC', sans-serif;
        --font-cn: 'Noto Sans SC', sans-serif;
        --easing: cubic-bezier(0.4, 0, 0.2, 1);
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-body);
        background: var(--bg-dark);
        background-image: var(--bg-gradient);
        color: var(--text-primary);
        overflow: hidden;
        line-height: 1.6;
      }

      /* ===== SCROLL CONTAINER ===== */
      .deck-container {
        height: 100vh;
        overflow-y: scroll;
        scroll-snap-type: y mandatory;
        scroll-behavior: smooth;
        position: relative;
      }

      /* ===== SECTIONS ===== */
      section {
        height: 100vh;
        width: 100%;
        scroll-snap-align: start;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 4rem 6rem;
        position: relative;
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
      }

      section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(ellipse at 50% 0%, rgba(0, 212, 255, 0.05) 0%, transparent 60%);
        pointer-events: none;
      }

      /* ===== ENTRANCE ANIMATIONS ===== */
      .animate-in {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.8s var(--easing), transform 0.8s var(--easing);
      }

      .animate-in.visible {
        opacity: 1;
        transform: translateY(0);
      }

      .delay-1 { transition-delay: 0.1s; }
      .delay-2 { transition-delay: 0.2s; }
      .delay-3 { transition-delay: 0.3s; }
      .delay-4 { transition-delay: 0.4s; }

      /* ===== TYPOGRAPHY ===== */
      h1 {
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.1;
        margin-bottom: 1rem;
      }

      h2 {
        font-family: var(--font-display);
        font-size: clamp(2rem, 4vw, 3.5rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-bottom: 2rem;
      }

      h3 {
        font-family: var(--font-display);
        font-size: clamp(1.25rem, 2vw, 1.75rem);
        font-weight: 600;
        color: var(--text-secondary);
        margin-bottom: 0.5rem;
      }

      p {
        font-size: clamp(1rem, 1.5vw, 1.25rem);
        color: var(--text-secondary);
        max-width: 60ch;
        line-height: 1.7;
      }

      .subtitle {
        font-family: var(--font-cn);
        font-size: clamp(1.1rem, 2vw, 1.5rem);
        font-weight: 400;
        color: var(--text-secondary);
        margin-bottom: 2rem;
      }

      .accent {
        color: var(--accent);
      }

      .accent-warm {
        color: var(--accent-warm);
      }

      /* ===== SECTION 1: INTRO ===== */
      .intro-tags {
        display: flex;
        gap: 1.5rem;
        margin-top: 2rem;
        flex-wrap: wrap;
        justify-content: center;
      }

      .tag {
        font-family: var(--font-cn);
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.5rem 1rem;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 9999px;
        color: var(--text-muted);
      }

      .tag.highlight {
        border-color: rgba(0, 212, 255, 0.3);
        color: var(--accent);
        background: rgba(0, 212, 255, 0.05);
      }

      /* ===== CARDS & GRID ===== */
      .cards-row {
        display: flex;
        gap: 2rem;
        width: 100%;
        max-width: 1000px;
        margin: 2rem 0;
      }

      .card {
        flex: 1;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 1rem;
        padding: 2rem;
        backdrop-filter: blur(10px);
      }

      .card-icon {
        font-size: 2rem;
        margin-bottom: 1rem;
      }

      .card-title {
        font-family: var(--font-cn);
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: var(--text-primary);
      }

      .card-desc {
        font-family: var(--font-cn);
        font-size: 0.9rem;
        color: var(--text-muted);
        line-height: 1.6;
      }

      /* ===== CREDENTIAL BANNER ===== */
      .credential-banner {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 1.25rem auto 0.5rem;
        padding: 0.75rem 1.25rem;
        background: linear-gradient(135deg, rgba(51, 112, 255, 0.12), rgba(0, 212, 255, 0.08));
        border: 1px solid rgba(51, 112, 255, 0.25);
        border-radius: 10px;
        max-width: 600px;
        color: var(--text-primary);
        transition: border-color 0.3s var(--easing), background 0.3s var(--easing);
      }
      .credential-banner:hover {
        border-color: var(--accent);
        background: linear-gradient(135deg, rgba(51, 112, 255, 0.18), rgba(0, 212, 255, 0.12));
      }
      .credential-icon {
        font-size: 1.5rem;
        flex-shrink: 0;
      }
      .credential-text {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        font-family: var(--font-cn);
        color: var(--text-primary);
      }
      .credential-text strong {
        font-size: 0.9rem;
        color: var(--accent);
      }
      .credential-sub {
        font-size: 0.75rem;
        color: var(--text-secondary);
      }

      /* ===== STATS ===== */
      .stats-row {
        display: flex;
        gap: 3rem;
        margin: 2rem 0;
        flex-wrap: wrap;
        justify-content: center;
      }

      .stat-item {
        text-align: center;
      }

      .stat-value {
        font-family: var(--font-display);
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        color: var(--accent);
        line-height: 1;
      }

      .stat-desc {
        font-family: var(--font-cn);
        font-size: 0.875rem;
        color: var(--text-muted);
        margin-top: 0.5rem;
      }

      /* ===== HORIZONTAL TIMELINE ===== */
      .h-timeline {
        display: flex;
        gap: 0;
        width: 100%;
        max-width: 1100px;
        margin-top: 2rem;
        position: relative;
        overflow-x: auto;
        padding-bottom: 1rem;
      }

      .h-timeline::before {
        content: '';
        position: absolute;
        top: 40px;
        left: 0;
        right: 0;
        height: 2px;
        background: var(--card-border);
      }

      .h-timeline-item {
        flex: 1;
        min-width: 140px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        position: relative;
        padding: 0 0.5rem;
      }

      .h-timeline-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--accent);
        border: 2px solid var(--bg-dark);
        box-shadow: 0 0 8px var(--accent-glow);
        margin-bottom: 1rem;
        position: relative;
        z-index: 1;
        flex-shrink: 0;
      }

      .h-timeline-dot.current {
        width: 16px;
        height: 16px;
        box-shadow: 0 0 16px var(--accent-glow);
      }

      .h-timeline-year {
        font-family: var(--font-display);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--accent);
        margin-bottom: 0.75rem;
        white-space: nowrap;
      }

      .h-timeline-role {
        font-family: var(--font-cn);
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-primary);
        line-height: 1.3;
      }

      .h-timeline-company {
        font-family: var(--font-cn);
        font-size: 0.7rem;
        color: var(--text-muted);
        line-height: 1.3;
      }

      @media (max-width: 1024px) {
        .h-timeline {
          flex-wrap: nowrap;
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
          scroll-snap-type: x proximity;
        }
        .h-timeline-item {
          min-width: 120px;
          scroll-snap-align: center;
        }
      }

      /* ===== SKILLS GRID ===== */
      .skills-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        width: 100%;
        max-width: 1000px;
        margin-top: 1.5rem;
      }

      .skill-block {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 1rem;
        padding: 1.5rem;
        backdrop-filter: blur(10px);
      }

      .skill-block-title {
        font-family: var(--font-cn);
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--accent);
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .skill-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .skill-tag {
        font-family: var(--font-cn);
        font-size: 0.75rem;
        padding: 0.3rem 0.6rem;
        background: rgba(0, 212, 255, 0.06);
        border: 1px solid rgba(0, 212, 255, 0.15);
        border-radius: 6px;
        color: var(--text-secondary);
      }

      @media (max-width: 768px) {
        .skills-grid {
          grid-template-columns: 1fr;
        }
      }

      /* ===== TIMELINE (vertical, kept for reference) ===== */
      .timeline {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        width: 100%;
        max-width: 800px;
        margin-top: 2rem;
      }

      .timeline-item {
        display: flex;
        gap: 1.5rem;
        align-items: baseline;
        padding: 1rem 0;
        border-bottom: 1px solid var(--card-border);
      }

      .timeline-year {
        font-family: var(--font-display);
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--accent);
        min-width: 100px;
        flex-shrink: 0;
      }

      .timeline-role {
        font-family: var(--font-cn);
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-primary);
      }

      .timeline-company {
        font-family: var(--font-cn);
        font-size: 0.9rem;
        color: var(--text-secondary);
      }

      /* ===== NAVIGATION DOTS ===== */
      .nav-dots {
        position: fixed;
        right: 2rem;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        z-index: 100;
      }

      .nav-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--card-border);
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        padding: 0;
      }

      .nav-dot.active {
        background: var(--accent);
        transform: scale(1.3);
        box-shadow: 0 0 10px var(--accent-glow);
      }

      .nav-dot:hover {
        background: var(--text-muted);
      }

      /* ===== SCROLL INDICATOR ===== */
      .scroll-indicator {
        position: fixed;
        right: 2rem;
        bottom: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-muted);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        animation: bounce 2s infinite;
      }

      .scroll-indicator svg {
        width: 24px;
        height: 24px;
        stroke: var(--text-muted);
      }

      @keyframes bounce {
        0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
        40% { transform: translateY(-10px); }
        60% { transform: translateY(-5px); }
      }

      /* ===== BOTTOM RIGHT SPACER (for webcam) ===== */
      .webcam-spacer {
        position: fixed;
        bottom: 0;
        right: 0;
        width: 280px;
        height: 200px;
        pointer-events: none;
        z-index: 99;
      }

      /* ===== MATCH HIGHLIGHT ===== */
      .match-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        width: 100%;
        max-width: 900px;
        margin-top: 1.5rem;
      }

      .match-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 0.75rem;
        font-family: var(--font-cn);
        font-size: 0.95rem;
        color: var(--text-secondary);
      }

      .match-check {
        color: var(--accent);
        font-size: 1.1rem;
        flex-shrink: 0;
      }

      /* ===== RESPONSIVE ===== */
      @media (max-width: 1024px) {
        section {
          padding: 3rem 2rem;
        }
        
        .cards-row {
          flex-direction: column;
        }

        .match-grid {
          grid-template-columns: 1fr;
        }
        
        .nav-dots {
          right: 1rem;
        }
        
        .webcam-spacer {
          width: 200px;
          height: 150px;
        }
      }

      @media (max-width: 768px) {
        .stats-row {
          gap: 1.5rem;
        }
        
        .timeline-item {
          flex-direction: column;
          gap: 0.5rem;
        }
        
        .timeline-year {
          min-width: auto;
        }
      }
    </style>
  </head>
  <body>
    <div class="deck-container" id="deck">
      
      <!-- Section 0: INTRO -->
      <section data-index="0">
        <h1 class="animate-in" style="font-family: var(--font-cn);">邵明鉴<br/><span class="accent" style="font-size: 0.6em;">飞书 × AI · 效率赋能</span></h1>
        <p class="subtitle animate-in delay-1">12 年数字化业务经验 · 3 年 + 飞书深度落地 · AI 工具链实战</p>
        <div class="intro-tags animate-in delay-2">
          <span class="tag highlight">飞书 3 年+</span>
          <span class="tag highlight">AI Agent 开发</span>
          <span class="tag">40+ 流程数字化</span>
          <span class="tag">英语专八</span>
          <span class="tag">德语专四</span>
        </div>
      </section>

      <!-- Section 1: CAREER TIMELINE (horizontal) -->
      <section data-index="1">
        <h2 class="animate-in" style="font-family: var(--font-cn);">职业<span class="accent">轨迹</span></h2>
        <p class="animate-in delay-1" style="font-family: var(--font-cn); color: var(--text-secondary); text-align: center; margin-bottom: 1rem;">12 年 · 出版 → 教育 → 企业服务 → AI</p>
        <div class="h-timeline animate-in delay-2">
          <div class="h-timeline-item">
            <div class="h-timeline-year">2013–2017</div>
            <div class="h-timeline-dot"></div>
            <div class="h-timeline-role">数字出版负责人</div>
            <div class="h-timeline-company">上海译文出版社</div>
          </div>
          <div class="h-timeline-item">
            <div class="h-timeline-year">2018–2019</div>
            <div class="h-timeline-dot"></div>
            <div class="h-timeline-role">数字业务负责人</div>
            <div class="h-timeline-company">企鹅兰登</div>
          </div>
          <div class="h-timeline-item">
            <div class="h-timeline-year">2019–2020</div>
            <div class="h-timeline-dot"></div>
            <div class="h-timeline-role">业务拓展总监</div>
            <div class="h-timeline-company">玩瞳科技</div>
          </div>
          <div class="h-timeline-item">
            <div class="h-timeline-year">2021</div>
            <div class="h-timeline-dot"></div>
            <div class="h-timeline-role">BD 经理</div>
            <div class="h-timeline-company">牛津大学出版社</div>
          </div>
          <div class="h-timeline-item">
            <div class="h-timeline-year">2021–2024</div>
            <div class="h-timeline-dot"></div>
            <div class="h-timeline-role">IT 与信息化总监</div>
            <div class="h-timeline-company">HUBS</div>
          </div>
          <div class="h-timeline-item">
            <div class="h-timeline-year">2024–2025</div>
            <div class="h-timeline-dot"></div>
            <div class="h-timeline-role">信息中心总监</div>
            <div class="h-timeline-company">接力文化</div>
          </div>
          <div class="h-timeline-item">
            <div class="h-timeline-year">2025–Now</div>
            <div class="h-timeline-dot current"></div>
            <div class="h-timeline-role">AI 产品 / ERP 顾问</div>
            <div class="h-timeline-company">启元科技</div>
          </div>
        </div>
      </section>

      <!-- Section 2: SKILLS OVERVIEW -->
      <section data-index="2">
        <h2 class="animate-in" style="font-family: var(--font-cn);">核心<span class="accent">技能</span></h2>
        <p class="animate-in delay-1" style="font-family: var(--font-cn); color: var(--text-secondary); text-align: center; max-width: 700px;">
          从内容产业数字化到 AIGC 产品落地，从飞书效率体系到 ERP 全流程交付
        </p>
        <div class="skills-grid animate-in delay-2">
          <div class="skill-block">
            <div class="skill-block-title">🤖 AIGC 产品与技术</div>
            <div class="skill-tags">
              <span class="skill-tag">MCP 智能体开发</span>
              <span class="skill-tag">AI Agent 工作流</span>
              <span class="skill-tag">Prompt Engineering</span>
              <span class="skill-tag">ComfyUI 图文生成</span>
              <span class="skill-tag">RAG 知识库</span>
              <span class="skill-tag">本地大模型部署</span>
            </div>
          </div>
          <div class="skill-block">
            <div class="skill-block-title">📋 产品设计与落地</div>
            <div class="skill-tags">
              <span class="skill-tag">PRD 撰写（20+ 单据）</span>
              <span class="skill-tag">AI 辅助 HTML 原型</span>
              <span class="skill-tag">需求调研与竞品分析</span>
              <span class="skill-tag">验收标准制定</span>
              <span class="skill-tag">飞书项目合作讲师</span>
            </div>
          </div>
          <div class="skill-block">
            <div class="skill-block-title">🏢 业务与跨部门协调</div>
            <div class="skill-tags">
              <span class="skill-tag">项目交付 3000 万+</span>
              <span class="skill-tag">央企/外企大客户</span>
              <span class="skill-tag">供应商管理</span>
              <span class="skill-tag">团队组建与培训</span>
              <span class="skill-tag">ISO27001 审计</span>
            </div>
          </div>
          <div class="skill-block">
            <div class="skill-block-title">🔧 信息化基础</div>
            <div class="skill-tags">
              <span class="skill-tag">飞书 3 年 + 深度落地</span>
              <span class="skill-tag">ERP 实施（用友 YonBIP）</span>
              <span class="skill-tag">CRM/SCRM 搭建</span>
              <span class="skill-tag">服务器运维</span>
              <span class="skill-tag">网络架构</span>
            </div>
          </div>
        </div>
        <div class="intro-tags animate-in delay-3" style="margin-top: 1.5rem;">
          <span class="tag highlight">英语专八</span>
          <span class="tag highlight">德语专四</span>
          <span class="tag">上海外国语大学</span>
        </div>
      </section>

      <!-- Section 3: FEISHU — BUSINESS SUPPORT -->
      <section data-index="3">
        <h2 class="animate-in" style="font-family: var(--font-cn);">飞书，<span class="accent">我的主战场</span> · 业务支持</h2>
        <div class="stats-row animate-in delay-1">
          <div class="stat-item">
            <div class="stat-value">872</div>
            <div class="stat-desc">CRM 客户规模</div>
          </div>
          <div class="stat-item">
            <div class="stat-value">¥4600 万</div>
            <div class="stat-desc">业绩目标规划</div>
          </div>
          <div class="stat-item">
            <div class="stat-value">¥1 亿</div>
